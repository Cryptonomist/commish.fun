# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# NEXT_PUBLIC_ variables are compiled into the browser bundle. Anything there is
# public forever. Only the Helius RPC URL and the Supabase anon key belong there,
# and both are protected by something other than secrecy:
#   · the Helius key is domain-restricted to commish.fun in the Helius dashboard
#   · the Supabase anon key is governed by row level security
#
# Everything below the line is server-only: it is read inside route handlers and
# never reaches the client. Set these in the Vercel dashboard, not in the repo.

# ── Public ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The deployed Anchor program. Fill in after the first `anchor deploy`.
NEXT_PUBLIC_PROGRAM_ID=

# Local validator only. Set to 1 if, and only if, the deployed program was built
# with `anchor build -- --features devnet,fastclock`.
#
# That build shortens the program's result-posting floor to 60s and its minimum
# dispute window to 30s, and this flag shortens the client's copies of the same
# numbers plus the season it generates: eighteen weeks two minutes apart,
# starting two minutes from now, so a whole pool can be played in half an hour
# instead of half a season.
#
# The two halves must agree. A fastclock program with this unset gives a form
# that refuses schedules the chain would take; this set against an ordinary
# program gives a form that builds pools the chain rejects. Leave it empty for
# devnet and mainnet.
NEXT_PUBLIC_FAST_CLOCK=

# ── Server only ───────────────────────────────────────────────────────────────
# Bypasses RLS. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the Vercel cron routes check before doing anything. Generate a
# long random value: `openssl rand -hex 32`
CRON_SECRET=
