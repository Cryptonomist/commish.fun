# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# NEXT_PUBLIC_ variables are compiled into the browser bundle. Anything there is
# public forever, so each one needs a reason it is safe to publish, and the
# reason has to be true.
#
# THE RPC URL IS NOT CURRENTLY PROTECTED. This block used to assert that the
# Helius key was domain-restricted to commish.fun, which was worse than saying
# nothing: it is exactly the kind of note that stops the next person checking.
# It was tested and it is false. Every origin gets a 200 and an
# `access-control-allow-origin: *`, including origins with no connection to this
# site, and so does a request with no Origin header at all.
#
# The endpoint in the deployed bundle is a Helius SECURE URL, the form where the
# credential is the subdomain rather than an `?api-key=` parameter. Helius
# offers those precisely for code that cannot hide a key, which is the tell:
# the subdomain IS the secret, and the dashboard's domain rules did not apply to
# it when tested. A secret sitting in a public JavaScript bundle is not a
# secret, so today anyone who opens devtools has a working endpoint on this
# quota.
#
# The fix Helius recommends for this exact case is their RPC proxy, a
# one-click Cloudflare Worker (github.com/helius-labs/helius-rpc-proxy). The key
# lives in the worker as an encrypted variable, CORS_ALLOW_ORIGIN pins the
# browsers allowed to use it, and NEXT_PUBLIC_RPC_URL becomes the worker's URL,
# which is safe to publish because it carries no credential. Server-side code
# does not need the proxy and should hold a direct key in RPC_URL below.
#
# Until that exists: this is devnet, so the exposure is quota rather than money.
# Do not carry this arrangement to mainnet.
#
# The Supabase anon key is a different case. It is designed to be public and is
# governed by row level security.
#
# Everything below the line is server-only: it is read inside route handlers and
# never reaches the client. Set these in the Vercel dashboard, not in the repo.

# ── Public ────────────────────────────────────────────────────────────────────
# The Cloudflare Worker proxy once it exists. A bare Helius URL here, in either
# form, publishes whatever authenticates it.
NEXT_PUBLIC_RPC_URL=https://REPLACE_ME.workers.dev
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The deployed Anchor program. Fill in after the first `anchor deploy`.
NEXT_PUBLIC_PROGRAM_ID=

# Local validator only. Set to 1 if, and only if, the deployed program was built
# with `anchor build -- --features devnet,fastclock`.
#
# That build shortens the program's result-posting floor to 60s and its minimum
# dispute window to 30s, and this flag shortens the client's copies of the same
# numbers plus the season it generates: eighteen weeks two minutes apart,
# starting two minutes from now, so a whole pool can be played in half an hour
# instead of half a season.
#
# The two halves must agree. A fastclock program with this unset gives a form
# that refuses schedules the chain would take; this set against an ordinary
# program gives a form that builds pools the chain rejects. Leave it empty for
# devnet and mainnet.
NEXT_PUBLIC_FAST_CLOCK=

# ── Server only ───────────────────────────────────────────────────────────────
# Bypasses RLS. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the Vercel cron routes check before doing anything. Generate a
# long random value: `openssl rand -hex 32`
CRON_SECRET=

# ── X sign-in ─────────────────────────────────────────────────────────────────
# From the X developer portal: an OAuth 2.0 app, type "Web App", with the
# callback URL set to exactly
#
#     https://commish.fun/api/auth/x/callback
#
# X compares that string byte for byte. A trailing slash, http instead of https,
# or the www host is a different URL to X and the exchange fails with an opaque
# error. Add http://localhost:3000/api/auth/x/callback as a second callback if
# you want the flow to work locally.
#
# The scopes requested are `users.read tweet.read` and nothing else. No
# `offline.access`, so X never mints a refresh token and there is nothing
# long-lived to store or leak. The access token is used once, inside the
# callback, to ask X who signed in, and is then dropped.
#
# TWITTER_CLIENT_ID / TWITTER_CLIENT_SECRET are accepted as aliases.
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Cloudflare D1 ─────────────────────────────────────────────────────────────
# The only database. Holds who a wallet says they are on X, whether they agreed
# to be named publicly, and a cached copy of standings. No money, no picks, no
# pool state: all of that is on chain. Schema in db/schema.sql.
#
# Vercel cannot use a D1 binding, so this goes through Cloudflare's HTTP API and
# needs a token. Scope it to D1 Edit on this one database and nothing else: the
# token can read and drop every table it can reach.
#
# CLOUDFLARE_ACCOUNT_ID / D1_DATABASE_ID / CLOUDFLARE_API_TOKEN are accepted as
# aliases.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# The server's own RPC, used by the leaderboard, which reads every Pool and
# Member account in one pass.
#
# This is where a direct Helius URL belongs. It is read inside a route handler,
# never inlined into the bundle, and never reaches a browser, so the credential
# in it stays a credential. Once NEXT_PUBLIC_RPC_URL points at a CORS-locked
# proxy, this is the only place a real key should appear.
#
# Falling back to NEXT_PUBLIC_RPC_URL when this is empty keeps local development
# working with one variable. The fallback also sends a Referer naming the site,
# which is what a domain rule would want from a server that has no Origin of its
# own; harmless when no rule is in force, and correct the day one is.
RPC_URL=
